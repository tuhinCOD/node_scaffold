{
	"name": "scaffold",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "tsx watch --tsconfig tsconfig.backend.json src/framework/server.ts",
		"dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
		"dev:frontend": "vite src/resources",
		"dev:backend": "tsx watch --tsconfig tsconfig.backend.json src/framework/server.ts",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "vite preview src/resources",
		"build-only": "vite build src/resources",
		"type-check": "vue-tsc --build",
		"test": "echo \"Error: no test specified\" && exit 1",
		"check": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node src/framework/module-cli/src/index.mjs db:seed",
		"module:seed": "node src/framework/module-cli/src/index.mjs module:seed",
		"module": "node src/framework/module-cli/src/index.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@biomejs/biome": "^2.5.12",
		"@scalar/express-api-reference": "^0.10.19",
		"axios": "^1.20.0",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"bullmq": "^6.3.4",
		"commander": "^15.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv-expand": "^1000.0.0",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"express-fileupload": "^1.5.2",
		"glob": "^13.0.6",
		"http-status-codes": "^2.3.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"lodash": "^4.18.1",
		"morgan": "^1.12.0",
		"multer": "^2.3.0",
		"nodemailer": "^10.0.0",
		"pg": "^8.23.0",
		"pinia": "^4.0.2",
		"sass-embedded": "^1.104.0",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"swagger-jsdoc": "^6.3.0",
		"vue": "^3.5.40",
		"vue-router": "^5.2.0",
		"winston": "^3.19.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.4",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/express-fileupload": "^1.5.1",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"@types/swagger-jsdoc": "^6.0.4",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"biome": "^0.3.3",
		"concurrently": "^10.0.5",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"nodemon": "^3.1.14",
		"npm-run-all2": "^9.0.2",
		"tsx": "^4.23.13",
		"typescript": "~6.0.0",
		"vite": "^8.1.5",
		"vite-plugin-vue-devtools": "^8.1.5",
		"vue-tsc": "^3.3.7"
	},
	"engines": {
		"node": "^22.18.0 || >=24.12.0"
	}
